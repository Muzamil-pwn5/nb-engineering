# Required application settings
DATABASE_URL=postgresql+psycopg://user:password@host:5432/nb_engineering
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret

# Public API security
CORS_ORIGINS=https://nbengineerings.com,https://www.nbengineerings.com

# Inquiry email delivery. For Gmail, use smtp.gmail.com with a Google App Password.
INQUIRY_NOTIFICATION_EMAIL=nbengineerings@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=nbengineerings@gmail.com
SMTP_PASSWORD=replace-with-a-gmail-app-password
SMTP_FROM_EMAIL=nbengineerings@gmail.com
SMTP_USE_TLS=true
